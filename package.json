{
  "name": "company-qa-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Playwright and TypeScript test automation for six applications",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:app": "tsx scripts/run-app.ts",
    "test:all": "tsx scripts/run-all.ts",
    "validate:config": "tsx scripts/validate-config.ts",
    "validate:environment": "tsx scripts/validate-environment.ts",
    "clean": "tsx scripts/clean-artifacts.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
